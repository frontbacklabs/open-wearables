# Minimum environment for running Alembic migrations (`uv run alembic upgrade head`).
#
# WHERE THIS FILE GOES
#   Settings are loaded from a HARDCODED path — `backend/config/.env` (see the
#   `env_file` in app/config.py). A `.env` sitting next to this file is NOT read.
#   Copy it into place:
#
#       cp .env.example config/.env
#
#   Or skip the file entirely and export the variables — real environment variables
#   take precedence over the .env file, which is how Cloud Run supplies them.
#
#   `config/.env.example` is the full application config (provider OAuth secrets,
#   Redis, S3, Svix, email, …). This file is the migration-only subset: Alembic
#   imports app.config, so the whole Settings object still has to construct, but
#   only the database values below affect what it actually does.

#--- REQUIRED ---#

# The only setting with no default. Alembic never uses it, but Settings refuses to
# construct without it, so migrations fail at import time if it is missing. Any
# non-empty string works for a migration run; use a real secret for a running app.
SECRET_KEY=dev-secret-change-me

#--- DATABASE (all have defaults; override to match where Postgres actually is) ---#

# Default is `db`, the service name on the docker-compose network. Running Alembic
# from your host against the compose database needs `localhost` instead — this is the
# one you are most likely to have to change.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=open-wearables
DB_USER=open-wearables
DB_PASSWORD=open-wearables

# An ABSOLUTE path in DB_HOST means a Unix socket directory rather than a hostname,
# and DB_PORT is then ignored. This is how Cloud Run reaches Cloud SQL:
# DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE

#--- NOT NEEDED FOR MIGRATIONS ---#
#
# Alembic builds its own NullPool engine, so DB_POOL_SIZE / DB_MAX_OVERFLOW /
# DB_ASYNC_* / DB_POOL_TIMEOUT / DB_STATEMENT_TIMEOUT_MS are read but do not apply to
# a migration run. Redis, S3, Svix, email and every provider credential are likewise
# irrelevant here — see config/.env.example when you need to run the app itself.
